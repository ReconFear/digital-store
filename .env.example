# Пример настроек Digital Store. Скопируйте в .env и заполните. В .env.example НЕ пишите настоящие значения.
# .env не должен попадать в Git и архивы.

# --- база данных ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_store
# После перехода на раздельные роли (DB_ROLES.md) — digital_store_app; до этого — прежний пользователь.
DB_USER=digital_store_app
DB_PASSWORD=

# --- CORS (необязательно) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- ограничение запросов (http_security.py) ---
# HTTP_RATE_LIMITS=on
# Адреса обратных прокси (nginx), от которых принимается X-Forwarded-For:
# TRUSTED_PROXY_IPS=127.0.0.1

# --- платежи (PAYMENTS.md). По умолчанию выключены. ---
PAYMENTS_ENABLED=false
# PAYMENTS_PROVIDER=yookassa
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# test — тестовый магазин ЮKassa (ключ test_...). live требует ещё PAYMENTS_ALLOW_LIVE=I_UNDERSTAND_REAL_MONEY.
# YOOKASSA_MODE=test
# PAYMENT_RETURN_URL=https://shop.example/payment/return
# YOOKASSA_TIMEOUT_SECONDS=10
# YOOKASSA_MAX_ATTEMPTS=3
# YOOKASSA_WEBHOOK_IP_CHECK=true
# Домены ссылки оплаты, на которые можно отправить покупателя:
# YOOKASSA_CONFIRMATION_HOSTS=yoomoney.ru,yookassa.ru
